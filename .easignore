# EAS archives start at the Git repository root, including for this monorepo.
# This file replaces ALL .gitignore files in EAS; keep their exclusions in sync.
# It also avoids EAS scanning ignored PostgreSQL data for nested .gitignore files.
# Directory exclusions omit the trailing slash so EAS skips traversal itself.

# From .gitignore
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
postgresql
!helm/chart/charts/postgresql
!helm/chart/charts/postgresql/**
node_modules
.cache
.pnpm-store
pnpm-store
dist
dist-ssr
*.local
.env
.vitepress/dist
.vitepress/cache
.nuxt
.output
private
coverage
Thumbs.db
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
supabase/.temp
supabase/config.toml
supabase/functions/**/*.d.ts
supabase/functions/**/*.full.ts
__pycache__
SparkyFitnessServer/uploads
SparkyFitnessServer/backup
SparkyFitnessServer/temp_uploads
SparkyFitnessGarmin/mock_data
SparkyFitnessServer/mock_data
WIP
docker/docker_volume
*.tsbuildinfo
dossier sans titre
/result
/result-*
.mcp.json
/dockerdata

