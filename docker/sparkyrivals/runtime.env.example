# Generated privately under dockerdata/config/runtime.env. No build credentials.
# Both origins must be the same public HTTPS origin behind NPM.
SPARKY_FITNESS_FRONTEND_URL=@PUBLIC_URL@
BETTER_AUTH_URL=@PUBLIC_URL@
SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_MOBILE_AUTH_SCHEMES=sparkyrivals
SPARKY_FITNESS_TRUSTED_PROXY_HOPS=2
SPARKY_FITNESS_REAL_IP_HEADER=
SPARKY_FITNESS_LOG_LEVEL=INFO
SPARKY_FITNESS_DISABLE_SIGNUP=false
SPARKY_FITNESS_DEMO_MODE=false
ALLOW_PRIVATE_NETWORK_CORS=false
TZ=Etc/UTC
# Set an operator email before first registration; restrict signup afterward.
SPARKY_FITNESS_ADMIN_EMAIL=
# Optional upstream settings (SMTP, OIDC, integrations, rate limits, outbound
# proxies) can be added here. See docker/.env.example and environment docs.
# Put secret values in dockerdata/secrets and reference /run/secrets/<file>
# through the existing *_FILE convention; do not put mobile signing here.
