// Capture final EAS-injected phone signing, with no independent Wear key interface.
gradle.projectsEvaluated {
    android.buildTypes.debug.signingConfig = phone.buildTypes.debug.signingConfig
    android.buildTypes.release.signingConfig = phone.buildTypes.release.signingConfig
